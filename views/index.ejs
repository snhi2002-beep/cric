<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
</head>
<body>

<nav class="navbar">
    <div class="navbar-brand">
        <div class="brand-icon">
            <svg viewBox="0 0 24 24">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
        </div>
        <span class="brand-name">Cric IPTV</span>
        <div class="status-pill">
            <span class="status-dot"></span>
            LIVE
        </div>
    </div>

    <div class="navbar-user">
        <div class="user-badge">
            <span class="user-avatar"><%= user.username.charAt(0).toUpperCase() %></span>
            <span><%= user.username %></span>
        </div>
        <form action="/logout" method="POST" style="display:inline;">
            <button type="submit" class="logout-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                Sign Out
            </button>
        </form>
    </div>
</nav>

<main class="main-wrapper">
    <div class="player">
        <video id="video" autoplay muted playsinline data-stream-url="<%= streamUrl %>"></video>

        <div class="top-bar">
            <div class="live-badge">🔴 LIVE</div>
            <button id="goLive">Go Live</button>
        </div>

        <div class="buffering" id="buffering">Buffering...</div>

        <div class="controls">
            <button id="play" title="Play/Pause">⏸</button>
            <input type="range" id="volume" min="0" max="1" step="0.1" value="1" title="Volume">
            <select id="quality" title="Quality"></select>
            <button id="fullscreen" title="Toggle Fullscreen">⛶</button>
        </div>
    </div>
</main>

<script src="/js/player.js"></script>
</body>
</html>
