<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body>

<div class="auth-container">
    <div class="auth-card">
        <div class="brand-header">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
            </div>
            <h1 class="brand-title">Welcome Back</h1>
            <p class="brand-subtitle">Sign in to access live IPTV streaming</p>
        </div>

        <% if (error && error.length > 0) { %>
            <div class="alert alert-error">
                <span>⚠️</span>
                <span><%= error %></span>
            </div>
        <% } %>

        <% if (success && success.length > 0) { %>
            <div class="alert alert-success">
                <span>✓</span>
                <span><%= success %></span>
            </div>
        <% } %>

        <form action="/login" method="POST">
            <div class="form-group">
                <label class="form-label" for="loginIdentifier">Username or Email</label>
                <div class="input-wrapper">
                    <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <input class="form-input" type="text" id="loginIdentifier" name="loginIdentifier" placeholder="Enter your username or email" required autofocus autocomplete="username">
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="password">Password</label>
                <div class="input-wrapper">
                    <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <input class="form-input" type="password" id="password" name="password" placeholder="Enter your password" required autocomplete="current-password">
                </div>
            </div>

            <button type="submit" class="btn-primary">Sign In</button>
        </form>

        <div class="demo-box">
            <strong>Pre-configured Demo Account:</strong><br>
            User: <span class="demo-badge">demo_user</span> &bull; Pass: <span class="demo-badge">password123</span>
        </div>

        <div class="auth-footer">
            Don't have an account yet?
            <a class="auth-link" href="/register">Create one</a>
        </div>
    </div>
</div>

</body>
</html>
